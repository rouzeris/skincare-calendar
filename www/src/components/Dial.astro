<div class="dial" aria-hidden="true">
  <svg width="44" height="44" viewBox="0 0 44 44">
    <circle
      cx="22"
      cy="22"
      r="20"
      fill="oklch(0.2 0.042 4 / 0.35)"
      stroke="oklch(0.76 0.05 10 / 0.4)"
      stroke-width="1"></circle>
    <g class="dial-disc">
      <circle cx="22" cy="10" r="5" fill="oklch(0.85 0.16 80)"></circle>
      <path
        d="M25 32.5a6 6 0 1 1-5.5-9.3 4.8 4.8 0 0 0 5.5 9.3Z"
        fill="oklch(0.9 0.02 10)"></path>
    </g>
  </svg>
</div>

<style>
  .dial {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: var(--z-dial);
    pointer-events: none;
    opacity: 0.9;
  }

  .dial-disc {
    transform-origin: 22px 22px;
    transform: rotate(calc(var(--scroll-p, 0) * 180deg));
  }

  @media (max-width: 720px) {
    .dial {
      display: none;
    }
  }
</style>

<script>
  const setP = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    doc.style.setProperty("--scroll-p", p.toFixed(4));
  };

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let raf = 0;
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(setP);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    setP();
  }
</script>
