---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PhoneFrame from "./PhoneFrame.astro";
import { t, type Locale } from "../i18n/ui";

const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/app/shelf-*-light.png",
  { eager: true },
);

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
---

<section
  class="border-t border-day-line bg-day-surface py-section text-day-ink"
  aria-labelledby="shelf-title"
>
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-[7fr_5fr] items-center gap-[clamp(2.5rem,6vw,6rem)] px-gutter max-[820px]:grid-cols-1"
  >
    <div>
      <h2 id="shelf-title" class="max-w-[16ch] text-h2">
        {tr("shelf.title")}
      </h2>
      <p class="mt-6 max-w-[40ch] text-lead text-day-subtle">
        {tr("shelf.body")}
      </p>
    </div>
    <PhoneFrame
      class="reveal w-[min(18rem,80vw)] justify-self-center drop-shadow-[0_24px_36px_oklch(0.4_0.09_25/0.24)]"
    >
      <Image
        src={shots[`../assets/app/shelf-${locale}-light.png`]!.default}
        alt={tr("shelf.imgAlt")}
        width={390}
        densities={[1, 2]}
        loading="lazy"
      />
    </PhoneFrame>
  </div>
</section>
