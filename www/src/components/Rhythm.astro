---
import RhythmPlayground from "./RhythmPlayground";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const labels = {
  retinol: tr("freq.viz.retinol"),
  acid: tr("freq.viz.acid"),
  cream: tr("freq.viz.cream"),
  day: tr("viz.day"),
  morning: tr("viz.morning"),
  evening: tr("viz.evening"),
  tapHint: tr("viz.tapHint"),
};
---

<section
  class="relative overflow-clip bg-[linear-gradient(180deg_in_oklch,oklch(0.42_0.085_355)_0%,oklch(0.26_0.055_330)_55%,var(--color-night-bg)_100%)] pt-section pb-[calc(var(--spacing-section)+clamp(6rem,14vh,9rem))] font-[380] tracking-[0.01em] text-dusk-ink"
  aria-labelledby="rhythm-title"
>
  <div
    class="lamp-drift absolute inset-0 bg-[radial-gradient(50rem_34rem_at_85%_10%,oklch(0.6_0.11_35/0.3),transparent_60%),radial-gradient(42rem_30rem_at_0%_60%,oklch(0.45_0.09_300/0.35),transparent_65%)] [mask-image:linear-gradient(180deg,transparent_0%,black_22%)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto w-full max-w-6xl px-[clamp(1.25rem,4vw,2.5rem)]">
    <h2 id="rhythm-title" class="max-w-[18ch] text-h2 font-medium">
      {tr("freq.title")}
    </h2>
    <p class="mt-6 max-w-[46ch] text-lead text-dusk-subtle">
      {tr("freq.body")}
    </p>

    <RhythmPlayground client:visible labels={labels} />
  </div>
</section>

<style>
  @supports (animation-timeline: view()) {
    .lamp-drift {
      animation: lamp-drift linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }

    @keyframes lamp-drift {
      from {
        transform: translateY(-6%);
      }
      to {
        transform: translateY(10%);
      }
    }
  }
</style>
