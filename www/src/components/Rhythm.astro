---
import RhythmPlayground from "./RhythmPlayground";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const labels = {
  retinol: tr("freq.viz.retinol"),
  acid: tr("freq.viz.acid"),
  cream: tr("freq.viz.cream"),
  day: tr("viz.day"),
  morning: tr("viz.morning"),
  evening: tr("viz.evening"),
  tapHint: tr("viz.tapHint"),
};
---

<section
  class="relative overflow-clip border-t border-[#46272F] bg-[radial-gradient(70rem_46rem_at_28%_20%,oklch(0.58_0.1_0/0.5),transparent_62%),radial-gradient(56rem_38rem_at_105%_38%,oklch(0.44_0.1_300/0.55),transparent_62%),linear-gradient(180deg_in_oklch,#B4898B_0%,oklch(0.4_0.085_350)_45%,oklch(0.26_0.055_330)_72%,var(--color-night-bg)_100%)] pt-[calc(var(--spacing-section)+clamp(3rem,8vh,6rem))] pb-[calc(var(--spacing-section)+clamp(5rem,10vh,7rem))] font-[380] tracking-[0.01em] text-dusk-ink"
  aria-labelledby="rhythm-title"
>
  <div
    class="lamp-drift absolute inset-0 bg-[radial-gradient(46rem_30rem_at_84%_8%,oklch(0.72_0.1_45/0.4),transparent_58%),radial-gradient(40rem_28rem_at_-5%_52%,oklch(0.5_0.08_320/0.4),transparent_62%)] [mask-image:linear-gradient(180deg,transparent_2%,black_26%)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto w-full max-w-6xl px-[clamp(1.25rem,4vw,2.5rem)]">
    <h2 id="rhythm-title" class="max-w-[18ch] text-h2 font-medium">
      {tr("freq.title")}
    </h2>
    <p class="mt-6 max-w-[46ch] text-lead text-dusk-subtle">
      {tr("freq.body")}
    </p>

    <RhythmPlayground client:visible labels={labels} />
  </div>
</section>

<style>
  @supports (animation-timeline: view()) {
    .lamp-drift {
      animation: lamp-drift linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }

    @keyframes lamp-drift {
      from {
        transform: translateY(-6%);
      }
      to {
        transform: translateY(10%);
      }
    }
  }
</style>
