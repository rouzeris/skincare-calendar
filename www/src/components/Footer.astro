---
import { locales, localePath, t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
---

<footer class="theme-night site-footer">
  <div class="container footer-row">
    <span class="wordmark">cera<span class="dot">.</span></span>
    <nav class="footer-links" aria-label="Legal">
      <a href="/privacy">{tr("footer.privacy")}</a>
      <a href="/terms">{tr("footer.terms")}</a>
    </nav>
    <nav class="footer-langs" aria-label={tr("a11y.langSwitch")}>
      {
        locales.map((l) => (
          <a
            href={localePath(l)}
            aria-current={l === locale ? "page" : undefined}
            lang={l === "ua" ? "uk" : l}
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>
    <small>{tr("footer.copyright")}</small>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-12);
    font-size: var(--text-small);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-8);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 560;
  }

  .wordmark .dot {
    color: var(--accent);
  }

  .footer-links,
  .footer-langs {
    display: flex;
    gap: var(--space-6);
  }

  .site-footer a {
    color: var(--subtle);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .footer-langs a[aria-current="page"] {
    color: var(--ink);
  }

  small {
    margin-left: auto;
    color: var(--subtle);
  }

  @media (max-width: 640px) {
    .footer-row {
      flex-direction: column;
      gap: var(--space-6);
    }
    small {
      margin-left: 0;
    }
  }
</style>
