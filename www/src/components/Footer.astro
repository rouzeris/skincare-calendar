---
import { t, type Locale } from "../i18n/ui";
import LangSelect from "./LangSelect.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
---

<footer
  class="border-t border-night-line bg-night-bg py-12 text-sm text-night-ink"
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-8 px-[clamp(1.25rem,4vw,2.5rem)] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-6"
  >
    <span class="text-lg font-bold tracking-tight"
      >cera<span class="text-night-accent">.</span></span
    >
    <nav class="flex gap-6" aria-label="Legal">
      <a
        href="/privacy"
        class="text-night-subtle no-underline hover:text-night-ink hover:underline hover:underline-offset-[0.35em]"
        >{tr("footer.privacy")}</a
      >
      <a
        href="/terms"
        class="text-night-subtle no-underline hover:text-night-ink hover:underline hover:underline-offset-[0.35em]"
        >{tr("footer.terms")}</a
      >
    </nav>
    <LangSelect locale={locale} />
    <small class="ml-auto text-night-subtle max-[640px]:ml-0"
      >{tr("footer.copyright")}</small
    >
  </div>
</footer>
