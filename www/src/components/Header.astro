---
import { localePath, type Locale } from "../i18n/ui";
import LangSelect from "./LangSelect.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<header
  class="absolute inset-x-0 top-0 z-10 pt-[clamp(1rem,3vw,2rem)] text-day-ink"
>
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between px-[clamp(1.25rem,4vw,2.5rem)]"
  >
    <a
      href={localePath(locale)}
      class="text-xl font-bold tracking-tight text-day-ink no-underline max-md:text-lg"
      >cera<span class="text-day-accent">.</span></a
    >
    <LangSelect locale={locale} />
  </div>
</header>
