---
import { locales, localePath, type Locale } from "../i18n/ui";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
---

<header class="site-header">
  <div class="container header-row">
    <a href={localePath(locale)} class="wordmark">cera<span>.</span></a>
    <nav aria-label={tr("a11y.langSwitch")} class="lang-nav">
      {
        locales.map((l) => (
          <a
            href={localePath(l)}
            aria-current={l === locale ? "page" : undefined}
            lang={l === "ua" ? "uk" : l}
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-header);
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--day-ink);
  }

  .wordmark span {
    color: var(--day-accent);
  }

  .lang-nav {
    display: flex;
    gap: var(--space-4);
  }

  .lang-nav a {
    font-size: 0.8125rem;
    font-weight: 480;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--night-subtle);
    padding: var(--space-2);
  }

  .lang-nav a[aria-current="page"] {
    color: var(--night-ink);
    text-decoration: underline;
    text-underline-offset: 0.4em;
    text-decoration-color: var(--night-accent);
    text-decoration-thickness: 2px;
  }

  .lang-nav a:hover {
    color: var(--night-ink);
  }

  @media (max-width: 720px) {
    .wordmark {
      font-size: 1.25rem;
    }
    .lang-nav {
      gap: var(--space-2);
    }
  }
</style>
