---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WaitlistForm from "./WaitlistForm";
import { t, type Locale } from "../i18n/ui";

const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/app/routine-*.png",
  { eager: true },
);
const shot = (locale: Locale, scheme: "light" | "dark") =>
  shots[`../assets/app/routine-${locale}-${scheme}.png`]!.default;

interface Props {
  locale: Locale;
  waitlistEndpoint?: string;
}

const { locale, waitlistEndpoint } = Astro.props;
const tr = t(locale);
const h1Words = tr("hero.h1").split(" ");

const labels = {
  label: tr("waitlist.label"),
  placeholder: tr("waitlist.placeholder"),
  cta: tr("waitlist.cta"),
  sending: tr("waitlist.sending"),
  hint: tr("waitlist.hint"),
  success: tr("waitlist.success"),
  error: tr("waitlist.error"),
  invalid: tr("waitlist.invalid"),
};
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-night"></div>
  </div>

  <div class="hero-inner container">
    <p class="halves" aria-hidden="true">
      <span class="half-day">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
          ></path></svg
        >
        {tr("hero.morning")}
      </span>
      <span class="half-night">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
        >
        {tr("hero.evening")}
      </span>
    </p>

    <div class="seam-text">
      <div class="st st-day">
        <h1>
          {
            h1Words.map((w, i) => (
              <>
                <span class="w" style={`--i:${i}`}>
                  {w}
                </span>
                {i < h1Words.length - 1 ? " " : ""}
              </>
            ))
          }
        </h1>
        <p class="sub">{tr("hero.sub")}</p>
      </div>
      <div class="st st-night" aria-hidden="true">
        <h1>
          {
            h1Words.map((w, i) => (
              <>
                <span class="w" style={`--i:${i}`}>
                  {w}
                </span>
                {i < h1Words.length - 1 ? " " : ""}
              </>
            ))
          }
        </h1>
        <p class="sub">{tr("hero.sub")}</p>
      </div>
    </div>

    <div class="hero-form">
      <WaitlistForm
        client:idle
        labels={labels}
        locale={locale}
        endpoint={waitlistEndpoint}
        id="hero-wl"
      />
    </div>

    <div class="phone">
      <Image
        src={shot(locale, "light")}
        alt={tr("hero.phoneAlt")}
        width={390}
        densities={[1, 2]}
        loading="eager"
      />
      <Image
        src={shot(locale, "dark")}
        alt=""
        width={390}
        densities={[1, 2]}
        loading="eager"
        class="phone-dark"
        aria-hidden="true"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    color: var(--day-ink);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--day-bg);
  }

  .hero-bg-night {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--night-bg), oklch(0.16 0.04 350));
    clip-path: inset(0 0 0 50%);
    animation: seam-in 1100ms var(--ease-out-quint) both;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(6rem, 14vh, 9rem);
  }

  .halves {
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 46rem;
    font-size: var(--text-small);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    animation: rise 700ms var(--ease-out-quint) 850ms both;
  }

  .halves span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .half-day {
    color: var(--day-subtle);
  }

  .half-night {
    color: var(--night-subtle);
  }

  .seam-text {
    position: relative;
    width: 100%;
    text-align: center;
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }

  .st h1 {
    font-size: var(--text-display);
    font-weight: 540;
    max-width: 14ch;
    margin-inline: auto;
  }

  .st h1 .w {
    display: inline-block;
    animation: rise 800ms var(--ease-out-quint) both;
    animation-delay: calc(150ms + var(--i) * 70ms);
  }

  .st .sub {
    font-size: var(--text-lead);
    max-width: 44ch;
    margin: var(--space-6) auto 0;
    animation: rise 800ms var(--ease-out-quint) 520ms both;
  }

  .st-day {
    color: var(--day-ink);
  }

  .st-day .sub {
    color: var(--day-subtle);
  }

  .st-night {
    position: absolute;
    inset: 0;
    color: var(--night-ink);
    clip-path: inset(0 0 0 50%);
  }

  .st-night .sub {
    color: var(--night-subtle);
  }

  .hero-form {
    margin-top: clamp(2.5rem, 5vh, 3.5rem);
    width: 100%;
    display: flex;
    justify-content: center;
    animation: rise 800ms var(--ease-out-quint) 700ms both;
  }

  .phone {
    position: relative;
    width: min(21rem, 76vw);
    margin-top: clamp(3rem, 7vh, 5rem);
    border-radius: 2.2rem 2.2rem 0 0;
    box-shadow: 0 -18px 60px oklch(0.2 0.05 4 / 0.18);
    animation: phone-rise 1000ms var(--ease-out-expo) 300ms both;
  }

  .phone img {
    border-radius: 2.2rem 2.2rem 0 0;
  }

  .phone-dark {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 50%);
    animation: seam-in 1100ms var(--ease-out-quint) both;
  }

  @keyframes seam-in {
    from {
      clip-path: inset(0 0 0 100%);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @keyframes phone-rise {
    from {
      opacity: 0;
      transform: translateY(4rem);
    }
  }

  @media (max-width: 720px) {
    .halves {
      max-width: 100%;
      padding-inline: var(--space-2);
    }
  }
</style>
