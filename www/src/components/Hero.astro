---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WaitlistForm from "./WaitlistForm";
import { t, type Locale } from "../i18n/ui";

const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/app/routine-*.png",
  { eager: true },
);
const shot = (locale: Locale, scheme: "light" | "dark") =>
  shots[`../assets/app/routine-${locale}-${scheme}.png`]!.default;

interface Props {
  locale: Locale;
  waitlistEndpoint?: string;
}

const { locale, waitlistEndpoint } = Astro.props;
const tr = t(locale);
const h1Words = tr("hero.h1").split(" ");

const labels = {
  label: tr("waitlist.label"),
  placeholder: tr("waitlist.placeholder"),
  cta: tr("waitlist.cta"),
  sending: tr("waitlist.sending"),
  hint: tr("waitlist.hint"),
  success: tr("waitlist.success"),
  error: tr("waitlist.error"),
  invalid: tr("waitlist.invalid"),
};
---

<section class="hero theme-day">
  <div class="hero-light" aria-hidden="true"></div>
  <video
    class="hero-leaves"
    src="/shadows-loop.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"></video>

  <div class="hero-inner container">
    <p class="morning">
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
        ></path></svg
      >
      {tr("hero.morning")}
    </p>

    <h1>
      {
        h1Words.map((w, i) => (
          <>
            <span class="w" style={`--i:${i}`}>
              {w}
            </span>
            {i < h1Words.length - 1 ? " " : ""}
          </>
        ))
      }
    </h1>
    <p class="sub">{tr("hero.sub")}</p>

    <div class="hero-form">
      <WaitlistForm
        client:idle
        labels={labels}
        locale={locale}
        endpoint={waitlistEndpoint}
        id="hero-wl"
      />
    </div>

    <div class="phone">
      <Image
        src={shot(locale, "light")}
        alt={tr("hero.phoneAlt")}
        width={390}
        densities={[1, 2]}
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
  }

  .hero-light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        90rem 60rem at 18% -10%,
        oklch(0.95 0.035 55 / 0.9),
        transparent 60%
      ),
      radial-gradient(
        70rem 50rem at 85% 15%,
        oklch(0.93 0.045 17 / 0.55),
        transparent 65%
      );
  }

  .hero-leaves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    opacity: 0;
    filter: sepia(0.5) saturate(0.7) brightness(1.28);
    mask-image: linear-gradient(180deg, black 45%, transparent 88%);
    animation: leaves-in 2400ms var(--ease-out-quint) 400ms forwards;
  }

  @keyframes leaves-in {
    to {
      opacity: 0.24;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-leaves {
      display: none;
    }
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(7rem, 15vh, 10rem);
  }

  .morning {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--day-subtle);
    animation: rise 700ms var(--ease-out-quint) 750ms both;
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 540;
    max-width: 14ch;
    margin-top: var(--space-6);
  }

  h1 .w {
    display: inline-block;
    animation: rise 800ms var(--ease-out-quint) both;
    animation-delay: calc(120ms + var(--i) * 70ms);
  }

  .sub {
    font-size: var(--text-lead);
    max-width: 44ch;
    margin-top: var(--space-6);
    color: var(--day-subtle);
    animation: rise 800ms var(--ease-out-quint) 480ms both;
  }

  .hero-form {
    margin-top: clamp(2.5rem, 5vh, 3.5rem);
    width: 100%;
    display: flex;
    justify-content: center;
    animation: rise 800ms var(--ease-out-quint) 640ms both;
  }

  .phone {
    width: min(20rem, 74vw);
    margin-top: clamp(3rem, 7vh, 5rem);
    border-radius: 2.2rem 2.2rem 0 0;
    box-shadow:
      0 -2px 6px oklch(0.28 0.022 20 / 0.05),
      0 -14px 40px -8px oklch(0.4 0.09 30 / 0.22),
      0 -40px 90px -20px oklch(0.5 0.12 40 / 0.18);
    animation: phone-rise 1000ms var(--ease-out-expo) 280ms both;
  }

  .phone img {
    border-radius: 2.2rem 2.2rem 0 0;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @keyframes phone-rise {
    from {
      opacity: 0;
      transform: translateY(4rem);
    }
  }
</style>
