---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WaitlistForm from "./WaitlistForm";
import PhoneFrame from "./PhoneFrame.astro";
import { t, waitlistLabels, type Locale } from "../i18n/ui";

const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/app/routine-*.png",
  { eager: true },
);
const shot = (locale: Locale, scheme: "light" | "dark") =>
  shots[`../assets/app/routine-${locale}-${scheme}.png`]!.default;

interface Props {
  locale: Locale;
  waitlistEndpoint?: string;
}

const { locale, waitlistEndpoint } = Astro.props;
const tr = t(locale);
---

<section class="relative overflow-clip bg-day-bg text-day-ink">
  <div
    class="absolute inset-0 bg-[radial-gradient(90rem_60rem_at_18%_-10%,oklch(0.95_0.035_55/0.9),transparent_60%),radial-gradient(70rem_50rem_at_85%_15%,oklch(0.93_0.045_17/0.55),transparent_65%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="leaves-scroll pointer-events-none absolute inset-0 z-[5]"
    aria-hidden="true"
  >
    <video
      class="anim-leaves-in absolute inset-0 h-full w-full object-cover opacity-0 mix-blend-multiply [animation-delay:400ms] [filter:sepia(0.5)_saturate(0.7)_brightness(1.28)] [mask-image:linear-gradient(180deg,black_45%,transparent_88%)] motion-reduce:hidden"
      src="/shadows-loop.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"></video>
  </div>

  <div
    class="relative mx-auto flex w-full max-w-6xl flex-col items-center px-gutter pt-[clamp(7rem,15vh,10rem)] text-center min-[940px]:grid min-[940px]:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] min-[940px]:items-center min-[940px]:gap-[clamp(2.5rem,5vw,5rem)] min-[940px]:pb-section min-[940px]:text-left"
  >
    <div class="flex flex-col items-center min-[940px]:items-start">
      <h1
        class="anim-blur-in max-w-[14ch] text-display [animation-delay:120ms]"
      >
        {tr("hero.h1")}
      </h1>
      <p
        class="anim-blur-in mt-6 max-w-[44ch] text-lead text-day-subtle [animation-delay:340ms]"
      >
        {tr("hero.sub")}
      </p>

      <div
        class="hero-form mt-[clamp(2.5rem,5vh,3.5rem)] flex w-full justify-center min-[940px]:justify-start"
      >
        <WaitlistForm
          client:idle
          labels={waitlistLabels(locale)}
          locale={locale}
          endpoint={waitlistEndpoint}
          id="hero-wl"
          align="left"
        />
      </div>
    </div>

    <PhoneFrame
      class="anim-blur-in mt-[clamp(3rem,7vh,5rem)] w-[min(20rem,74vw)] drop-shadow-[0_30px_40px_oklch(0.4_0.09_30/0.28)] [animation-delay:780ms] min-[940px]:mt-0 min-[940px]:justify-self-end"
    >
      <Image
        src={shot(locale, "light")}
        alt={tr("hero.phoneAlt")}
        width={390}
        densities={[1, 2]}
        loading="eager"
      />
    </PhoneFrame>
  </div>
</section>

<style>
  .hero-form :global(form > div:first-of-type) {
    animation: blur-in 1150ms var(--ease-out-quint) 560ms both;
  }

  .hero-form :global(form > p) {
    animation: blur-in 1150ms var(--ease-out-quint) 1000ms both;
  }

  @supports (animation-timeline: view()) {
    .leaves-scroll {
      animation: leaves-away linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }

    @keyframes leaves-away {
      to {
        transform: translateY(9%) scale(1.04);
        opacity: 0.25;
      }
    }
  }
</style>
