---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WaitlistForm from "./WaitlistForm";
import PhoneFrame from "./PhoneFrame.astro";
import { t, type Locale } from "../i18n/ui";

const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/app/routine-*.png",
  { eager: true },
);
const shot = (locale: Locale, scheme: "light" | "dark") =>
  shots[`../assets/app/routine-${locale}-${scheme}.png`]!.default;

interface Props {
  locale: Locale;
  waitlistEndpoint?: string;
}

const { locale, waitlistEndpoint } = Astro.props;
const tr = t(locale);
const h1Words = tr("hero.h1").split(" ");

const labels = {
  label: tr("waitlist.label"),
  placeholder: tr("waitlist.placeholder"),
  cta: tr("waitlist.cta"),
  sending: tr("waitlist.sending"),
  hint: tr("waitlist.hint"),
  success: tr("waitlist.success"),
  error: tr("waitlist.error"),
  invalid: tr("waitlist.invalid"),
};
---

<section class="relative overflow-clip bg-day-bg text-day-ink">
  <div
    class="absolute inset-0 bg-[radial-gradient(90rem_60rem_at_18%_-10%,oklch(0.95_0.035_55/0.9),transparent_60%),radial-gradient(70rem_50rem_at_85%_15%,oklch(0.93_0.045_17/0.55),transparent_65%)]"
    aria-hidden="true"
  >
  </div>
  <video
    class="anim-leaves-in absolute inset-0 h-full w-full object-cover opacity-0 mix-blend-multiply [animation-delay:400ms] [filter:sepia(0.5)_saturate(0.7)_brightness(1.28)] [mask-image:linear-gradient(180deg,black_45%,transparent_88%)] motion-reduce:hidden"
    src="/shadows-loop.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"></video>

  <div
    class="relative mx-auto flex w-full max-w-6xl flex-col items-center px-[clamp(1.25rem,4vw,2.5rem)] pt-[clamp(7rem,15vh,10rem)] text-center min-[940px]:grid min-[940px]:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] min-[940px]:items-center min-[940px]:gap-[clamp(2.5rem,5vw,5rem)] min-[940px]:pb-section min-[940px]:text-left"
  >
    <div class="flex flex-col items-center min-[940px]:items-start">
      <h1 class="max-w-[14ch] text-display">
        {
          h1Words.map((w, i) => (
            <>
              <span
                class="anim-rise inline-block"
                style={`animation-delay: calc(120ms + ${i} * 70ms)`}
              >
                {w}
              </span>
              {i < h1Words.length - 1 ? " " : ""}
            </>
          ))
        }
      </h1>
      <p
        class="anim-rise mt-6 max-w-[44ch] text-lead text-day-subtle [animation-delay:480ms]"
      >
        {tr("hero.sub")}
      </p>

      <div
        class="anim-rise mt-[clamp(2.5rem,5vh,3.5rem)] flex w-full justify-center min-[940px]:justify-start [animation-delay:640ms]"
      >
        <WaitlistForm
          client:idle
          labels={labels}
          locale={locale}
          endpoint={waitlistEndpoint}
          id="hero-wl"
          align="left"
        />
      </div>
    </div>

    <PhoneFrame
      class="anim-phone-rise mt-[clamp(3rem,7vh,5rem)] w-[min(20rem,74vw)] drop-shadow-[0_30px_40px_oklch(0.4_0.09_30/0.28)] [animation-delay:280ms] min-[940px]:mt-0 min-[940px]:justify-self-end"
    >
      <Image
        src={shot(locale, "light")}
        alt={tr("hero.phoneAlt")}
        width={390}
        densities={[1, 2]}
        loading="eager"
      />
    </PhoneFrame>
  </div>
</section>
