---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<figure class={`relative ${className}`}>
  <div
    class="relative rounded-[3rem] bg-[linear-gradient(160deg,oklch(0.32_0.02_280),oklch(0.16_0.015_280)_60%)] p-[10px] shadow-[inset_0_1px_1px_oklch(1_0_0/0.25),inset_0_-1px_1px_oklch(0_0_0/0.4)]"
  >
    <span
      class="absolute top-24 -left-[2px] h-8 w-[3px] rounded-l-sm bg-[oklch(0.25_0.015_280)]"
      aria-hidden="true"></span>
    <span
      class="absolute top-36 -left-[2px] h-12 w-[3px] rounded-l-sm bg-[oklch(0.25_0.015_280)]"
      aria-hidden="true"></span>
    <span
      class="absolute top-28 -right-[2px] h-16 w-[3px] rounded-r-sm bg-[oklch(0.25_0.015_280)]"
      aria-hidden="true"></span>
    <div
      class="relative overflow-clip rounded-[2.4rem] bg-[#FAFAF9] ring-1 ring-black/40"
    >
      <div
        class="flex aspect-[393/59] items-center justify-center"
        aria-hidden="true"
      >
        <span
          class="aspect-[125/37] w-[32%] rounded-full bg-[oklch(0.13_0.01_280)] shadow-[inset_0_0_2px_oklch(1_0_0/0.15)]"
        ></span>
      </div>
      <slot />
    </div>
  </div>
</figure>
