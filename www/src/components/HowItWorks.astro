---
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const steps = [1, 2, 3].map((n) => ({
  n,
  title: tr(`how.${n}.title` as Parameters<typeof tr>[0]),
  body: tr(`how.${n}.body` as Parameters<typeof tr>[0]),
}));
---

<section class="bg-day-bg py-section text-day-ink" aria-labelledby="how-title">
  <div class="mx-auto w-full max-w-6xl px-[clamp(1.25rem,4vw,2.5rem)]">
    <h2 id="how-title" class="max-w-[20ch] text-h2">{tr("how.title")}</h2>
    <ol
      class="mt-18 grid list-none grid-cols-3 gap-[clamp(2rem,5vw,4.5rem)] p-0 max-[820px]:max-w-xl max-[820px]:grid-cols-1 max-[820px]:gap-12"
    >
      {
        steps.map(({ n, title, body }) => (
          <li class="min-[821px]:even:translate-y-12">
            <span
              class="block text-5xl font-bold text-day-accent tabular-nums"
              aria-hidden="true"
            >
              {n}
            </span>
            <h3 class="mt-4 text-[1.375rem] font-semibold tracking-tight">
              {title}
            </h3>
            <p class="mt-3 text-day-subtle">{body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
