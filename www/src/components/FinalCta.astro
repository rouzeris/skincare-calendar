---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WaitlistForm from "./WaitlistForm";
import PhoneFrame from "./PhoneFrame.astro";
import { t, type Locale } from "../i18n/ui";

const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/app/routine-*.png",
  { eager: true },
);
const shot = (locale: Locale, scheme: "light" | "dark") =>
  shots[`../assets/app/routine-${locale}-${scheme}.png`]!.default;

interface Props {
  locale: Locale;
  waitlistEndpoint?: string;
}

const { locale, waitlistEndpoint } = Astro.props;
const tr = t(locale);

const labels = {
  label: tr("waitlist.label"),
  placeholder: tr("waitlist.placeholder"),
  cta: tr("waitlist.cta"),
  sending: tr("waitlist.sending"),
  hint: tr("waitlist.hint"),
  success: tr("waitlist.success"),
  error: tr("waitlist.error"),
  invalid: tr("waitlist.invalid"),
};
---

<section
  class="bg-[radial-gradient(40rem_28rem_at_50%_30%,oklch(0.32_0.07_4/0.55),transparent_70%)] bg-night-bg py-[calc(var(--spacing-section)*1.25)] font-[380] tracking-[0.01em] text-night-ink"
  aria-labelledby="final-title"
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-center px-[clamp(1.25rem,4vw,2.5rem)] text-center"
  >
    <PhoneFrame
      class="sleep-phone mb-16 w-[min(15rem,58vw)] drop-shadow-[0_24px_50px_oklch(0_0_0/0.45)]"
      screenClass="sleep-screen"
    >
      <div class="relative">
        <Image
          src={shot(locale, "light")}
          alt={tr("hero.phoneAlt")}
          width={300}
          densities={[1, 2]}
          loading="lazy"
        />
        <Image
          src={shot(locale, "dark")}
          alt=""
          width={300}
          densities={[1, 2]}
          loading="lazy"
          class="sleep-dark absolute inset-0"
          aria-hidden="true"
        />
      </div>
    </PhoneFrame>
    <h2 id="final-title" class="max-w-[18ch] text-h2 font-medium">
      {tr("final.title")}
    </h2>
    <p class="mt-6 max-w-[40ch] text-lead text-night-subtle">
      {tr("final.sub")}
    </p>
    <div class="mt-12 flex w-full justify-center">
      <WaitlistForm
        client:visible
        labels={labels}
        locale={locale}
        endpoint={waitlistEndpoint}
        id="final-wl"
        tone="night"
      />
    </div>
    {
      /* App store badges — uncomment at launch:
      <div>
        <h3>{tr("badges.title")}</h3>
        <a href="https://apps.apple.com/app/…">App Store</a>
        <a href="https://play.google.com/store/apps/details?id=…">Google Play</a>
      </div>
      */
    }
  </div>
</section>

<style>
  .sleep-dark {
    opacity: 1;
  }

  :global(.sleep-screen) {
    background-color: #1c1917;
  }

  @supports (animation-timeline: view()) {
    .sleep-dark {
      animation: fall-asleep linear both;
      animation-timeline: view();
      animation-range: entry 10% entry 85%;
    }

    :global(.sleep-screen) {
      animation: screen-asleep linear both;
      animation-timeline: view();
      animation-range: entry 10% entry 85%;
    }

    @keyframes fall-asleep {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes screen-asleep {
      from {
        background-color: #fafaf9;
      }
      to {
        background-color: #1c1917;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sleep-dark,
    :global(.sleep-screen) {
      animation: none;
    }
  }
</style>
