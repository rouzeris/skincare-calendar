---
import WaitlistForm from "./WaitlistForm";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  waitlistEndpoint?: string;
}

const { locale, waitlistEndpoint } = Astro.props;
const tr = t(locale);

const labels = {
  label: tr("waitlist.label"),
  placeholder: tr("waitlist.placeholder"),
  cta: tr("waitlist.cta"),
  sending: tr("waitlist.sending"),
  hint: tr("waitlist.hint"),
  success: tr("waitlist.success"),
  error: tr("waitlist.error"),
  invalid: tr("waitlist.invalid"),
};
---

<section class="section theme-night final" aria-labelledby="final-title">
  <div class="container final-inner">
    <svg
      class="moon"
      aria-hidden="true"
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
    <h2 id="final-title">{tr("final.title")}</h2>
    <p>{tr("final.sub")}</p>
    <div class="final-form">
      <WaitlistForm
        client:visible
        labels={labels}
        locale={locale}
        endpoint={waitlistEndpoint}
        id="final-wl"
      />
    </div>
    {
      /* App store badges — uncomment at launch (assets: public/badges/*)
      <div class="badges">
        <h3>{tr("badges.title")}</h3>
        <a href="https://apps.apple.com/app/…">App Store</a>
        <a href="https://play.google.com/store/apps/details?id=…">Google Play</a>
      </div>
      */
    }
  </div>
</section>

<style>
  .final {
    padding-block: calc(var(--section-pad) * 1.25);
  }

  .final-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .moon {
    color: var(--accent);
    margin-bottom: var(--space-8);
  }

  .final h2 {
    font-size: var(--text-h2);
    max-width: 18ch;
  }

  .final p {
    margin-top: var(--space-6);
    font-size: var(--text-lead);
    color: var(--subtle);
    max-width: 40ch;
  }

  .final-form {
    margin-top: var(--space-12);
    width: 100%;
    display: flex;
    justify-content: center;
  }
</style>
