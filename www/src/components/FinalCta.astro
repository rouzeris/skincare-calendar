---
import WaitlistForm from "./WaitlistForm";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  waitlistEndpoint?: string;
}

const { locale, waitlistEndpoint } = Astro.props;
const tr = t(locale);

const labels = {
  label: tr("waitlist.label"),
  placeholder: tr("waitlist.placeholder"),
  cta: tr("waitlist.cta"),
  sending: tr("waitlist.sending"),
  hint: tr("waitlist.hint"),
  success: tr("waitlist.success"),
  error: tr("waitlist.error"),
  invalid: tr("waitlist.invalid"),
};
---

<section
  class="bg-[radial-gradient(40rem_28rem_at_50%_30%,oklch(0.32_0.07_4/0.55),transparent_70%)] bg-night-bg py-[calc(var(--spacing-section)*1.25)] font-[380] tracking-[0.01em] text-night-ink"
  aria-labelledby="final-title"
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-center px-[clamp(1.25rem,4vw,2.5rem)] text-center"
  >
    <p
      class="inline-flex items-center gap-2 text-sm tracking-[0.09em] uppercase text-night-subtle"
    >
      <svg
        aria-hidden="true"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-night-accent"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
      {tr("hero.evening")}
    </p>
    <h2 id="final-title" class="mt-8 max-w-[18ch] text-h2 font-medium">
      {tr("final.title")}
    </h2>
    <p class="mt-6 max-w-[40ch] text-lead text-night-subtle">
      {tr("final.sub")}
    </p>
    <div class="mt-12 flex w-full justify-center">
      <WaitlistForm
        client:visible
        labels={labels}
        locale={locale}
        endpoint={waitlistEndpoint}
        id="final-wl"
        tone="night"
      />
    </div>
    {
      /* App store badges — uncomment at launch:
      <div>
        <h3>{tr("badges.title")}</h3>
        <a href="https://apps.apple.com/app/…">App Store</a>
        <a href="https://play.google.com/store/apps/details?id=…">Google Play</a>
      </div>
      */
    }
  </div>
</section>
