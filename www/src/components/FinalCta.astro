---
import WaitlistForm from "./WaitlistForm";
import { t, waitlistLabels, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  waitlistEndpoint?: string;
}

const { locale, waitlistEndpoint } = Astro.props;
const tr = t(locale);
---

<section
  class="border-t border-[#482830] bg-[radial-gradient(40rem_28rem_at_50%_30%,oklch(0.32_0.07_4/0.55),transparent_70%)] bg-night-bg py-[calc(var(--spacing-section)*1.25)] font-[380] tracking-[0.01em] text-night-ink"
  aria-labelledby="final-title"
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-center px-gutter text-center"
  >
    <h2 id="final-title" class="max-w-[18ch] text-h2 font-medium">
      {tr("final.title")}
    </h2>
    <p class="mt-6 max-w-[40ch] text-lead text-night-subtle">
      {tr("final.sub")}
    </p>
    <div class="mt-12 flex w-full justify-center">
      <WaitlistForm
        client:visible
        labels={waitlistLabels(locale)}
        locale={locale}
        endpoint={waitlistEndpoint}
        id="final-wl"
        tone="night"
      />
    </div>
    {
      /* App store badges — uncomment at launch:
      <div>
        <h3>{tr("badges.title")}</h3>
        <a href="https://apps.apple.com/app/…">App Store</a>
        <a href="https://play.google.com/store/apps/details?id=…">Google Play</a>
      </div>
      */
    }
  </div>
</section>
