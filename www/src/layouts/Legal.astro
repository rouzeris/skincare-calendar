---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  path: string;
}

const { title, path } = Astro.props;
---

<Base
  locale="en"
  title={`${title} — Cera`}
  description={`${title} for the Cera app.`}
  path={path}
>
  <div class="theme-day legal-page">
    <header class="container legal-header">
      <a href="/" class="back">← cera<span>.</span></a>
    </header>
    <main class="container legal-prose">
      <slot />
    </main>
  </div>
  <Footer locale="en" />
</Base>

<style>
  .legal-header {
    padding-block: var(--space-8);
  }

  .back {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 560;
    text-decoration: none;
  }

  .back span {
    color: var(--day-accent);
  }

  .legal-prose {
    max-width: 46rem;
    padding-bottom: var(--space-28);
  }

  .legal-prose :global(h1) {
    font-size: var(--text-h2);
    margin-block: var(--space-8) var(--space-6);
  }

  .legal-prose :global(h2) {
    font-size: 1.5rem;
    margin-block: var(--space-12) var(--space-4);
  }

  .legal-prose :global(h3) {
    font-size: 1.125rem;
    margin-block: var(--space-8) var(--space-3);
  }

  .legal-prose :global(p),
  .legal-prose :global(li) {
    margin-block: var(--space-3);
    color: var(--day-ink);
  }

  .legal-prose :global(a) {
    color: var(--day-accent);
  }
</style>
